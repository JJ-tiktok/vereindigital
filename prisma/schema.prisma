generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TeamMembershipStatus {
  ACTIVE
  INVITED
  INACTIVE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum CalendarEventType {
  TRAINING
  MATCH
  TEAM_EVENT
  OTHER
}

enum CalendarEventStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum AttendanceStatus {
  ACCEPTED
  MAYBE
  DECLINED
}

enum AvailabilityType {
  VACATION
  INJURY
  ILLNESS
  OTHER
}

enum MatchStatus {
  PLANNED
  LIVE
  FINISHED
  CANCELLED
}

enum MatchCompetition {
  LEAGUE
  CUP
  FRIENDLY
  OTHER
}

enum LineupStatus {
  STARTER
  SUBSTITUTE
  NOT_USED
}

enum TrainingExerciseCategory {
  WARMUP
  TECHNIQUE
  TACTICS
  CONDITIONING
  FINISHING
  GAME_FORM
  COOLDOWN
  OTHER
}

enum TrainingIntensity {
  LOW
  MEDIUM
  HIGH
}

enum TrainingExerciseVisibility {
  TEAM
  CLUB
}

enum TrainingPitchType {
  FULL_FIELD
  HALF_FIELD
  PENALTY_AREA
  SMALL_FIELD
  FREE_AREA
}

enum PlayerAttributeCategory {
  TECHNICAL
  TACTICAL
  PHYSICAL
  MENTAL
  GOALKEEPER
  POSITION_SPECIFIC
}

enum PlayerPositionGroup {
  ALL
  GOALKEEPER
  DEFENDER
  FULLBACK
  MIDFIELDER
  WINGER
  FORWARD
}

enum PlayerFileEntryType {
  PLAYER_TALK
  GOAL_AGREEMENT
  FEEDBACK
  TRAINING_OBSERVATION
  MATCH_OBSERVATION
  DISCIPLINE
  LOAD_INJURY
  OTHER
}

enum PlayerFileEntryVisibility {
  INTERNAL
  PLAYER
}

enum PlayerFormTrend {
  UP
  STABLE
  DOWN
}

enum ImportType {
  ROSTER
  MATCH_STATS
  FIXTURES
}

enum ImportSourceType {
  TEMPLATE_CSV
  AI_URL
}

enum ImportStatus {
  DRAFT
  PARSED
  CONFIRMED
  FAILED
}

enum FeedbackType {
  BUG
  FEATURE_REQUEST
  IMPROVEMENT
  OTHER
}

enum FeedbackStatus {
  NEW
  TRIAGED
  IN_PROGRESS
  DONE
  WONT_DO
}

enum FeedbackPriority {
  LOW
  MEDIUM
  HIGH
}

enum TacticDuty {
  DEFENSIVE
  BALANCED
  OFFENSIVE
}

enum TacticPhase {
  OFFENSE
  DEFENSE
}

enum ScoutingStatus {
  WATCHING
  CONTACTED
  TRIAL
  OFFER_MADE
  SIGNED
  REJECTED
  ARCHIVED
}

enum ScoutingEventType {
  PHONE_CALL
  MATCH_OBSERVED
  TRAINING_TRIAL
  MEETING
  VIDEO_REVIEW
  OTHER
}

model Club {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams                Team[]
  seasons              Season[]
  playerProfiles       PlayerProfile[]
  roles                Role[]
  memberships          ClubMembership[]
  invitations          Invitation[]
  trainingExercises    TrainingExercise[]
  attributeDefinitions PlayerAttributeDefinition[]
  importJobs           ImportJob[]
  feedbackItems        FeedbackItem[]
  tactics              Tactic[]
  tacticScenes         TacticScene[]
  scoutingProspects    ScoutingProspect[]

  @@map("clubs")
}

model Season {
  id        String   @id @default(cuid())
  clubId    String
  name      String
  startsAt  DateTime
  endsAt    DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club          Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  teams         Team[]
  importJobs    ImportJob[]
  feedbackItems FeedbackItem[]

  @@unique([clubId, name])
  @@index([clubId, isActive])
  @@map("seasons")
}

model Team {
  id        String   @id @default(cuid())
  clubId    String
  seasonId  String
  name      String
  ageGroup  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club               Club                      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  seasonRef          Season                    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  memberships        TeamMembership[]
  calendarEvents     CalendarEvent[]
  matches            Match[]
  invitations        Invitation[]
  attributeSnapshots PlayerAttributeSnapshot[]
  formSnapshots      PlayerFormSnapshot[]
  fileEntries        PlayerFileEntry[]
  trainingExercises  TrainingExercise[]
  importJobs         ImportJob[]
  feedbackItems      FeedbackItem[]
  tactics            Tactic[]
  tacticScenes       TacticScene[]

  @@unique([clubId, seasonId, name])
  @@index([clubId])
  @@index([seasonId])
  @@map("teams")
}

model User {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  email       String
  displayName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  playerProfiles                    PlayerProfile[]
  clubMemberships                   ClubMembership[]
  memberships                       TeamMembership[]
  attendancesSet                    EventAttendance[]           @relation("AttendanceSetBy")
  eventsCreated                     CalendarEvent[]             @relation("CalendarEventCreatedBy")
  invitationsCreated                Invitation[]                @relation("InvitationCreatedBy")
  exercisesCreated                  TrainingExercise[]          @relation("TrainingExerciseCreatedBy")
  attributeSnapshotsCreated         PlayerAttributeSnapshot[]   @relation("PlayerAttributeSnapshotCreatedBy")
  trainingPerformancesCreated       PlayerTrainingPerformance[] @relation("PlayerTrainingPerformanceCreatedBy")
  fileEntriesCreated                PlayerFileEntry[]           @relation("PlayerFileEntryCreatedBy")
  fileEntriesUpdated                PlayerFileEntry[]           @relation("PlayerFileEntryUpdatedBy")
  importJobsCreated                 ImportJob[]                 @relation("ImportJobCreatedBy")
  feedbackItemsCreated              FeedbackItem[]              @relation("FeedbackItemCreatedBy")
  tacticsCreated                    Tactic[]                    @relation("TacticCreatedBy")
  tacticScenesCreated                TacticScene[]              @relation("TacticSceneCreatedBy")
  scoutingProspectsCreated          ScoutingProspect[]          @relation("ScoutingProspectCreatedBy")
  scoutingEventsCreated             ScoutingEvent[]             @relation("ScoutingEventCreatedBy")
  scoutingEventsUpdated             ScoutingEvent[]             @relation("ScoutingEventUpdatedBy")
  scoutingAttributeSnapshotsCreated ScoutingAttributeSnapshot[] @relation("ScoutingAttributeSnapshotCreatedBy")
  feedbackNotifications             FeedbackNotification[]
  matchNotesCreated                 MatchNote[]                 @relation("MatchNoteCreatedBy")

  @@index([email])
  @@map("users")
}

model PlayerProfile {
  id           String    @id @default(cuid())
  clubId       String
  userId       String?
  firstName    String
  lastName     String
  birthDate    DateTime?
  position     String?
  jerseyNumber Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  club                 Club                        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user                 User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  memberships          TeamMembership[]
  attendances          EventAttendance[]
  availabilities       PlayerAvailability[]
  matchStats           PlayerMatchStat[]
  attributeSnapshots   PlayerAttributeSnapshot[]
  formSnapshots        PlayerFormSnapshot[]
  fileEntries          PlayerFileEntry[]
  trainingPerformances PlayerTrainingPerformance[]
  tacticSlots          TacticSlot[]
  matchLineupSlots     MatchLineupSlot[]
  scoutedFrom          ScoutingProspect?

  @@index([clubId])
  @@index([userId])
  @@map("player_profiles")
}

model Role {
  id           String   @id @default(cuid())
  clubId       String
  name         String
  key          String
  isSystemRole Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  club            Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  clubMemberships ClubMembership[]
  memberships     TeamMembership[]
  invitations     Invitation[]

  @@unique([clubId, key])
  @@index([clubId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model ClubMembership {
  id        String               @id @default(cuid())
  clubId    String
  userId    String
  roleId    String
  status    TeamMembershipStatus @default(ACTIVE)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([clubId, userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("club_memberships")
}

model TeamMembership {
  id              String               @id @default(cuid())
  teamId          String
  userId          String?
  playerProfileId String?
  roleId          String
  status          TeamMembershipStatus @default(ACTIVE)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  team          Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  playerProfile PlayerProfile? @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  role          Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([teamId, userId, roleId])
  @@unique([teamId, playerProfileId, roleId])
  @@index([teamId])
  @@index([userId])
  @@index([playerProfileId])
  @@index([roleId])
  @@map("team_memberships")
}

model Invitation {
  id              String           @id @default(cuid())
  clubId          String
  teamId          String?
  roleId          String
  email           String?
  token           String           @unique
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  createdByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  club          Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team          Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role          Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdByUser User? @relation("InvitationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([clubId])
  @@index([teamId])
  @@index([roleId])
  @@index([email])
  @@map("invitations")
}

model CalendarEvent {
  id              String              @id @default(cuid())
  teamId          String
  type            CalendarEventType
  title           String
  description     String?
  location        String?
  startsAt        DateTime
  endsAt          DateTime
  status          CalendarEventStatus @default(SCHEDULED)
  createdByUserId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  team                 Team                        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdByUser        User?                       @relation("CalendarEventCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  attendances          EventAttendance[]
  match                Match?
  trainingPlan         TrainingPlan?
  trainingPerformances PlayerTrainingPerformance[]
  scoutingEvents       ScoutingEvent[]

  @@index([teamId, startsAt])
  @@index([type])
  @@map("calendar_events")
}

model EventAttendance {
  id              String           @id @default(cuid())
  calendarEventId String
  playerProfileId String
  status          AttendanceStatus
  reason          String?
  setByUserId     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  calendarEvent CalendarEvent @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)
  playerProfile PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  setByUser     User?         @relation("AttendanceSetBy", fields: [setByUserId], references: [id], onDelete: SetNull)

  @@unique([calendarEventId, playerProfileId])
  @@index([playerProfileId])
  @@index([setByUserId])
  @@map("event_attendances")
}

model PlayerAvailability {
  id              String           @id @default(cuid())
  playerProfileId String
  type            AvailabilityType
  startsAt        DateTime
  endsAt          DateTime?
  note            String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  playerProfile PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)

  @@index([playerProfileId, startsAt, endsAt])
  @@map("player_availabilities")
}

model Match {
  id              String           @id @default(cuid())
  teamId          String
  calendarEventId String?          @unique
  tacticId        String?
  opponent        String
  isHomeGame      Boolean          @default(true)
  competition     MatchCompetition @default(LEAGUE)
  goalsFor        Int?
  goalsAgainst    Int?
  status          MatchStatus      @default(PLANNED)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  team          Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  calendarEvent CalendarEvent?    @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)
  tactic        Tactic?           @relation(fields: [tacticId], references: [id], onDelete: SetNull)
  playerStats   PlayerMatchStat[]
  lineupSlots   MatchLineupSlot[]
  notes         MatchNote[]

  @@index([teamId])
  @@index([tacticId])
  @@map("matches")
}

enum MatchNoteCategory {
  OWN_TEAM
  OPPONENT
  GENERAL
}

model MatchNote {
  id              String            @id @default(cuid())
  matchId         String
  category        MatchNoteCategory
  body            String            @db.Text
  createdByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  match         Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  createdByUser User? @relation("MatchNoteCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([matchId, category, createdAt])
  @@index([createdByUserId])
  @@map("match_notes")
}

model PlayerMatchStat {
  id              String       @id @default(cuid())
  matchId         String
  playerProfileId String
  goals           Int          @default(0)
  assists         Int          @default(0)
  yellowCards     Int          @default(0)
  redCards        Int          @default(0)
  minutesPlayed   Int          @default(0)
  lineupStatus    LineupStatus @default(NOT_USED)
  rating          Float?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  match         Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerProfile PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerProfileId])
  @@index([playerProfileId])
  @@map("player_match_stats")
}

model PlayerAttributeDefinition {
  id              String                  @id @default(cuid())
  clubId          String
  key             String
  name            String
  category        PlayerAttributeCategory
  positionGroup   PlayerPositionGroup     @default(ALL)
  subgroup        String?
  description     String?
  sortOrder       Int                     @default(0)
  isSystemDefault Boolean                 @default(false)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  club            Club                      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  ratings         PlayerAttributeRating[]
  scoutingRatings ScoutingAttributeRating[]

  @@unique([clubId, key])
  @@index([clubId, category])
  @@index([positionGroup])
  @@map("player_attribute_definitions")
}

model PlayerAttributeSnapshot {
  id              String   @id @default(cuid())
  playerProfileId String
  teamId          String
  season          String?
  title           String
  notes           String?
  ratedAt         DateTime
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  playerProfile PlayerProfile           @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  team          Team                    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdByUser User?                   @relation("PlayerAttributeSnapshotCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  ratings       PlayerAttributeRating[]

  @@index([playerProfileId, ratedAt])
  @@index([teamId])
  @@index([createdByUserId])
  @@map("player_attribute_snapshots")
}

model PlayerAttributeRating {
  id                    String   @id @default(cuid())
  snapshotId            String
  attributeDefinitionId String
  value                 Int
  note                  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  snapshot            PlayerAttributeSnapshot   @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  attributeDefinition PlayerAttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, attributeDefinitionId])
  @@index([attributeDefinitionId])
  @@map("player_attribute_ratings")
}

model PlayerTrainingPerformance {
  id              String   @id @default(cuid())
  calendarEventId String
  playerProfileId String
  rating          Float
  // Rate of Perceived Exertion (Borg CR10, 1-10): how hard this session felt to the player.
  // Combined with the session's duration (CalendarEvent.startsAt/endsAt), this drives the
  // Belastungsintensitaet (training load) metric on the dashboard - see dashboard/page.tsx.
  rpe             Int?
  note            String?
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  calendarEvent CalendarEvent @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)
  playerProfile PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  createdByUser User?         @relation("PlayerTrainingPerformanceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([calendarEventId, playerProfileId])
  @@index([playerProfileId])
  @@index([createdByUserId])
  @@map("player_training_performances")
}

model PlayerFormSnapshot {
  id              String          @id @default(cuid())
  playerProfileId String
  teamId          String
  value           Float
  trend           PlayerFormTrend @default(STABLE)
  calculatedFrom  String?
  notes           String?
  calculatedAt    DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  playerProfile PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  team          Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([playerProfileId, calculatedAt])
  @@index([teamId])
  @@map("player_form_snapshots")
}

model PlayerFileEntry {
  id              String              @id @default(cuid())
  playerProfileId String
  teamId          String
  type            PlayerFileEntryType
  visibility      PlayerFileEntryVisibility @default(INTERNAL)
  title           String
  body            String
  occurredAt      DateTime
  followUpAt      DateTime?
  season          String?
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  playerProfile PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  team          Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdByUser User?         @relation("PlayerFileEntryCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser User?         @relation("PlayerFileEntryUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([playerProfileId, occurredAt])
  @@index([playerProfileId, visibility])
  @@index([teamId])
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@map("player_file_entries")
}

model ImportJob {
  id              String           @id @default(cuid())
  clubId          String
  teamId          String
  seasonId        String
  type            ImportType
  sourceType      ImportSourceType
  status          ImportStatus     @default(DRAFT)
  sourceUrl       String?
  fileName        String?
  parsedData      Json?
  issues          Json?
  createdByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  club          Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team          Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  season        Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  createdByUser User?  @relation("ImportJobCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([clubId, createdAt])
  @@index([teamId, type, status])
  @@index([seasonId])
  @@index([createdByUserId])
  @@map("import_jobs")
}

model FeedbackItem {
  id              String           @id @default(cuid())
  clubId          String
  teamId          String?
  seasonId        String?
  createdByUserId String?
  type            FeedbackType
  status          FeedbackStatus   @default(NEW)
  priority        FeedbackPriority @default(MEDIUM)
  title           String
  description     String           @db.Text
  route           String?
  userAgent       String?          @db.Text
  viewportWidth   Int?
  viewportHeight  Int?
  screenshotData  String?          @db.Text
  context         Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  club          Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team          Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  season        Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  createdByUser User?   @relation("FeedbackItemCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  notifications FeedbackNotification[]

  @@index([clubId, status, createdAt])
  @@index([teamId])
  @@index([seasonId])
  @@index([createdByUserId])
  @@map("feedback_items")
}

model FeedbackNotification {
  id             String    @id @default(cuid())
  userId         String
  feedbackItemId String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedbackItem FeedbackItem @relation(fields: [feedbackItemId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([feedbackItemId])
  @@map("feedback_notifications")
}

model TrainingExercise {
  id              String                     @id @default(cuid())
  clubId          String
  teamId          String?
  createdByUserId String?
  title           String
  description     String?
  objective       String?
  organization    String?
  flow            String?
  coachingPoints  String?
  variations      String?
  material        String?
  category        TrainingExerciseCategory
  durationMinutes Int?
  minPlayers      Int?
  maxPlayers      Int?
  intensity       TrainingIntensity?
  visibility      TrainingExerciseVisibility @default(TEAM)
  pitchType       TrainingPitchType          @default(FREE_AREA)
  sketchData      Json?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  club          Club                     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team          Team?                    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdByUser User?                    @relation("TrainingExerciseCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  planExercises TrainingPlanExercise[]
  sketches      TrainingExerciseSketch[]

  @@index([clubId])
  @@index([teamId])
  @@index([createdByUserId])
  @@index([category])
  @@index([visibility])
  @@map("training_exercises")
}

model TrainingExerciseSketch {
  id                 String            @id @default(cuid())
  trainingExerciseId String
  title              String
  pitchType          TrainingPitchType @default(FREE_AREA)
  sketchData         Json?
  sortOrder          Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  trainingExercise TrainingExercise @relation(fields: [trainingExerciseId], references: [id], onDelete: Cascade)

  @@unique([trainingExerciseId, sortOrder])
  @@index([trainingExerciseId])
  @@map("training_exercise_sketches")
}

model TrainingPlan {
  id              String   @id @default(cuid())
  calendarEventId String   @unique
  objective       String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  calendarEvent CalendarEvent          @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)
  exercises     TrainingPlanExercise[]

  @@map("training_plans")
}

model TrainingPlanExercise {
  id                 String   @id @default(cuid())
  trainingPlanId     String
  trainingExerciseId String
  sortOrder          Int
  durationMinutes    Int?
  coachingPoints     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  trainingPlan     TrainingPlan     @relation(fields: [trainingPlanId], references: [id], onDelete: Cascade)
  trainingExercise TrainingExercise @relation(fields: [trainingExerciseId], references: [id], onDelete: Restrict)

  @@unique([trainingPlanId, sortOrder])
  @@index([trainingExerciseId])
  @@map("training_plan_exercises")
}

model Tactic {
  id               String   @id @default(cuid())
  clubId           String
  teamId           String
  name             String
  formation        String
  defenseFormation String   @default("4-4-2")
  styleValue       Int      @default(2)
  lineValue        Int      @default(2)
  pressingValue    Int      @default(2)
  widthValue       Int      @default(2)
  tempoValue       Int      @default(2)
  createdByUserId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  club          Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team          Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdByUser User?         @relation("TacticCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  slots         TacticSlot[]
  arrows        TacticArrow[]
  matches       Match[]

  @@index([clubId])
  @@index([teamId])
  @@map("tactics")
}

model TacticSlot {
  id              String      @id @default(cuid())
  tacticId        String
  phase           TacticPhase @default(OFFENSE)
  positionCode    String
  x               Float
  y               Float
  role            String
  duty            TacticDuty  @default(BALANCED)
  playerProfileId String?
  sortOrder       Int         @default(0)

  tactic        Tactic         @relation(fields: [tacticId], references: [id], onDelete: Cascade)
  playerProfile PlayerProfile? @relation(fields: [playerProfileId], references: [id], onDelete: SetNull)

  @@index([tacticId])
  @@index([playerProfileId])
  @@map("tactic_slots")
}

// A per-match, editable copy of a Tactic's OFFENSE slots. Snapshotted when a coach assigns a
// Tactic to a Match (see updateMatchTactic), so that assigning players to positions for a
// specific matchday never mutates the shared Tactic template used across other matches.
model MatchLineupSlot {
  id              String  @id @default(cuid())
  matchId         String
  positionCode    String
  x               Float
  y               Float
  sortOrder       Int     @default(0)
  playerProfileId String?

  match         Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerProfile PlayerProfile? @relation(fields: [playerProfileId], references: [id], onDelete: SetNull)

  @@index([matchId])
  @@index([playerProfileId])
  @@map("match_lineup_slots")
}

enum TacticSceneCategory {
  STANDARDS
  DEFENSE
  ATTACK
  MATCH_SCENE
  CUSTOM
}

// An animated tactical scene (corner routine, defensive shape, reconstructed match situation)
// built from a sequence of TacticSceneStep keyframes with its own generic element set - distinct
// from Tactic/TacticSlot (real formation planning) and TrainingExerciseSketch (single static
// training diagram). Presented fullscreen via ScenePresentation for the beamer.
model TacticScene {
  id                    String              @id @default(cuid())
  clubId                String
  teamId                String
  title                 String
  category              TacticSceneCategory @default(CUSTOM)
  pitchType             TrainingPitchType   @default(FULL_FIELD)
  description           String?
  defaultStepDurationMs Int                 @default(1500)
  createdByUserId       String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  club          Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team          Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdByUser User?             @relation("TacticSceneCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  steps         TacticSceneStep[]

  @@index([clubId])
  @@index([teamId])
  @@index([category])
  @@map("tactic_scenes")
}

model TacticSceneStep {
  id            String   @id @default(cuid())
  tacticSceneId String
  sortOrder     Int      @default(0)
  label         String?
  elementsData  Json
  transitionMs  Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tacticScene TacticScene @relation(fields: [tacticSceneId], references: [id], onDelete: Cascade)

  @@unique([tacticSceneId, sortOrder])
  @@index([tacticSceneId])
  @@map("tactic_scene_steps")
}

model ScoutingProspect {
  id                       String         @id @default(cuid())
  clubId                   String
  firstName                String
  lastName                 String
  birthDate                DateTime?
  positions                String[]       @default([])
  currentClub              String?
  phone                    String?
  email                    String?
  source                   String?
  interestLevel            Int?
  status                   ScoutingStatus @default(WATCHING)
  notes                    String?
  convertedPlayerProfileId String?        @unique
  createdByUserId          String?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  club                   Club                        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdByUser          User?                       @relation("ScoutingProspectCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  convertedPlayerProfile PlayerProfile?              @relation(fields: [convertedPlayerProfileId], references: [id], onDelete: SetNull)
  events                 ScoutingEvent[]
  attributeSnapshots     ScoutingAttributeSnapshot[]

  @@index([clubId, status])
  @@map("scouting_prospects")
}

model ScoutingEvent {
  id              String            @id @default(cuid())
  prospectId      String
  type            ScoutingEventType
  title           String
  body            String
  occurredAt      DateTime
  followUpAt      DateTime?
  calendarEventId String?
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  prospect      ScoutingProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  calendarEvent CalendarEvent?   @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)
  createdByUser User?            @relation("ScoutingEventCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser User?            @relation("ScoutingEventUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([prospectId, occurredAt])
  @@index([calendarEventId])
  @@map("scouting_events")
}

model ScoutingAttributeSnapshot {
  id              String   @id @default(cuid())
  prospectId      String
  title           String
  notes           String?
  ratedAt         DateTime @default(now())
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  prospect      ScoutingProspect          @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  createdByUser User?                     @relation("ScoutingAttributeSnapshotCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  ratings       ScoutingAttributeRating[]

  @@index([prospectId, ratedAt])
  @@map("scouting_attribute_snapshots")
}

model ScoutingAttributeRating {
  id                    String  @id @default(cuid())
  snapshotId            String
  attributeDefinitionId String
  value                 Int
  note                  String?

  snapshot            ScoutingAttributeSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  attributeDefinition PlayerAttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, attributeDefinitionId])
  @@index([attributeDefinitionId])
  @@map("scouting_attribute_ratings")
}

model TacticArrow {
  id        String      @id @default(cuid())
  tacticId  String
  phase     TacticPhase
  x1        Float
  y1        Float
  x2        Float
  y2        Float
  sortOrder Int         @default(0)

  tactic Tactic @relation(fields: [tacticId], references: [id], onDelete: Cascade)

  @@index([tacticId])
  @@map("tactic_arrows")
}
